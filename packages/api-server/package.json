{
  "name": "mail-guard-api",
  "version": "2.0.0",
  "description": "Mail Guard AI — API Gateway: Express server with rate limiting, auth, WebSocket, and Gemini integration",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "lint": "eslint src/",
    "db:generate": "npx prisma generate --schema=src/db/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=src/db/schema.prisma",
    "db:push": "npx prisma db push --schema=src/db/schema.prisma",
    "db:studio": "npx prisma studio --schema=src/db/schema.prisma"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^6.0.0",
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.0",
    "multer": "^2.3.0",
    "nanoid": "^5.0.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.2.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/ws": "^8.5.0",
    "eslint": "^9.10.0",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
