# ============================================
# Mail Guard AI — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# --- ML Service ---
ML_SERVICE_URL=http://localhost:8000
ML_MODEL_PATH=./models/distilbert-spam-v2

# --- API Server ---
NODE_ENV=development
API_PORT=3000
API_VERSION=v1

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://mailguard:mailguard@localhost:5432/mailguard

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Gemini API (get from https://aistudio.google.com) ---
GEMINI_API_KEY=

# --- Rate Limiting ---
RATE_LIMIT_FREE=50
RATE_LIMIT_PRO=1000

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
